# Copy → docker/api.test.env (gitignored) for local container smoke tests.
# Requires: docker compose up -d postgres redis

NODE_ENV=production
API_PORT=8387
DATABASE_URL=postgresql://aucobot:aucobot@host.docker.internal:5432/aucobot?schema=public
REDIS_URL=redis://host.docker.internal:6379
JWT_SECRET=dev-jwt-secret-change-me-in-production-min-32-chars
WEB_ORIGIN=http://localhost:8386/app
MARKETING_ORIGIN=http://localhost:8386
SWAGGER_ENABLED=true

# Required for NODE_ENV=production boot (GoogleStrategy validates clientID at startup)
GOOGLE_CLIENT_ID=smoke-test-client-id
GOOGLE_CLIENT_SECRET=smoke-test-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8387/api/auth/google/callback
