{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Aucobot API",
    "description": "Local dev — Auth (dev-login), Conversations, Messages (Phase A session + AucoAgent).\n\nImport kèm `aucobot-local.postman_environment.json`.\nChạy **Auth → Dev Login** trước các request cần cookie.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8387/api"
    },
    {
      "key": "conversationId",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Dev Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ok true', () => pm.expect(body.ok).to.eql(true));",
                  "if (body.cookies?.access_token?.value) {",
                  "  pm.collectionVariables.set('accessToken', body.cookies.access_token.value);",
                  "}",
                  "if (body.user?.id) {",
                  "  pm.collectionVariables.set('userId', body.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/dev-login",
            "description": "Development only (`NODE_ENV=development`). Sets `access_token` cookie.\n\nNếu Postman không tự gửi cookie, copy `cookies.access_token.value` vào biến `accessToken` — các request khác đã có header Cookie fallback."
          },
          "response": []
        },
        {
          "name": "Get Me",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "access_token={{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Conversations",
      "item": [
        {
          "name": "List Conversations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "access_token={{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/conversations"
          },
          "response": []
        },
        {
          "name": "Create Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.id) {",
                  "  pm.collectionVariables.set('conversationId', body.id);",
                  "  pm.environment.set('conversationId', body.id);",
                  "}",
                  "pm.test('type session', () => pm.expect(body.type).to.eql('session'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "access_token={{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"session\",\n  \"title\": \"Test AucoAgent\",\n  \"description\": \"Postman session\"\n}"
            },
            "url": "{{baseUrl}}/conversations",
            "description": "Auto-bind AucoAgent. Dùng `conversationId` cho Messages."
          },
          "response": []
        },
        {
          "name": "Create Room",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "access_token={{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"room\",\n  \"title\": \"My Room\"\n}"
            },
            "url": "{{baseUrl}}/conversations",
            "description": "Phase A: messages API chỉ hỗ trợ `session`, không phải `room`."
          },
          "response": []
        },
        {
          "name": "Get Conversation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "access_token={{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/conversations/{{conversationId}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Messages (Phase A)",
      "item": [
        {
          "name": "Send Message",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('has assistant reply', () => {",
                  "  pm.expect(body.assistantMessage?.content).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "access_token={{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Xin chào, bạn là ai?\"\n}"
            },
            "url": "{{baseUrl}}/conversations/{{conversationId}}/messages",
            "description": "Cần `ENABLED_FEATURES=ai-orchestration` + `TOGETHER_API_KEY`. Session only."
          },
          "response": []
        },
        {
          "name": "List Messages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "access_token={{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/conversations/{{conversationId}}/messages"
          },
          "response": []
        }
      ]
    }
  ]
}
