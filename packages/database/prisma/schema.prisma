generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  googleId        String?   @unique @map("google_id")
  avatarUrl       String?   @map("avatar_url")
  name            String?
  timezone        String    @default("Asia/Ho_Chi_Minh")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  conversations Conversation[]
  agents        Agent[]
  documents     Document[]
  agentMemories AgentMemory[]

  @@map("users")
}

enum ConversationType {
  room
  session
}

model Conversation {
  id            String           @id @default(cuid())
  userId        String           @map("user_id")
  type          ConversationType
  title         String
  description   String?
  lastMessageAt DateTime?        @map("last_message_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  members  ConversationMember[]
  messages Message[]
  documents Document[]
  agentMemories AgentMemory[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

model Agent {
  id                   String   @id @default(cuid())
  ownerId              String?  @map("owner_id")
  isSystem             Boolean  @default(false) @map("is_system")
  presetId             String   @map("preset_id")
  name                 String
  avatarUrl            String?  @map("avatar_url")
  bio                  String?
  role                 String   @default("")
  description          String?  @db.Text
  tonePreset           String   @default("friendly") @map("tone_preset")
  toneNotes            String?  @map("tone_notes") @db.Text
  enabledSkillGroups   String[] @default([]) @map("enabled_skill_groups")
  instructionsSource   Json?    @map("instructions_source")
  instructionsCompiled String   @map("instructions_compiled") @db.Text
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  owner    User?                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members  ConversationMember[]
  messages Message[]
  agentMemories AgentMemory[]

  @@index([ownerId])
  @@index([presetId])
  @@index([isSystem, presetId])
  @@map("agents")
}

model ConversationMember {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  agentId        String   @map("agent_id")
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([conversationId, agentId])
  @@map("conversation_members")
}

enum MessageSenderType {
  user
  agent
}

model Message {
  id             String            @id @default(uuid(7))
  conversationId String            @map("conversation_id")
  ownerId        String            @map("owner_id")
  senderType     MessageSenderType @map("sender_type")
  agentId        String?           @map("agent_id")
  content        String            @db.Text
  createdAt      DateTime          @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("messages")
}

enum DocumentExtractStatus {
  pending
  ready
  failed
}

model Document {
  id              String                @id @default(cuid())
  ownerId         String                @map("owner_id")
  conversationId  String                @map("conversation_id")
  title           String
  mimeType        String                @map("mime_type")
  sizeBytes       Int                   @map("size_bytes")
  r2Key           String                @map("r2_key")
  extractedText   String?               @map("extracted_text") @db.Text
  extractStatus   DocumentExtractStatus @default(pending) @map("extract_status")
  createdAt       DateTime              @default(now()) @map("created_at")

  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([ownerId])
  @@map("documents")
}

model AgentMemory {
  id             String   @id @default(cuid())
  ownerId        String   @map("owner_id")
  conversationId String?  @map("conversation_id")
  agentId        String   @map("agent_id")
  content        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([ownerId, agentId, createdAt])
  @@index([conversationId])
  @@map("agent_memories")
}

model RefreshToken {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum EmailOtpPurpose {
  login
  register
}

model EmailOtpChallenge {
  id        String          @id @default(uuid(7))
  email     String
  purpose   EmailOtpPurpose
  codeHash  String          @unique @map("code_hash")
  attempts  Int             @default(0)
  expiresAt DateTime        @map("expires_at")
  usedAt    DateTime?       @map("used_at")
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([email, purpose])
  @@index([expiresAt])
  @@map("email_otp_challenges")
}
