# ----------------------------- Production -----------------------------
# Đặt trên hosting (Railway / Vercel / …). KHÔNG commit file chứa secret thật.
# KHÔNG set DEV_AUTH_EMAIL — POST /api/auth/dev-login trả 404 khi NODE_ENV=production.

# ----------------------------- NESTJS Backend -----------------------------

# Database (PostgreSQL) — managed provider (Neon, Railway, …)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aucobot?schema=public&sslmode=require"

# API server
API_PORT=8387
WEB_ORIGIN="https://app.aucobot.com"
MARKETING_ORIGIN="https://www.aucobot.com"
NODE_ENV=production
SWAGGER_ENABLED=false

# Auth (JWT httpOnly cookie) — bắt buộc secret mạnh, ≥32 ký tự
JWT_SECRET="CHANGE_ME_generate_with_crypto_randomBytes_32"
JWT_ACCESS_EXPIRES_IN=15m
AUTH_ACCESS_COOKIE_MAX_AGE_MS=900000
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
AUTH_REFRESH_COOKIE_MAX_AGE_MS=2592000000

# Share session cookies across www / app / api
AUTH_COOKIE_DOMAIN=.aucobot.com

# Google OAuth (Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.aucobot.com/api/auth/google/callback

# Email (Resend — transactional)
RESEND_API_KEY=
EMAIL_FROM="Aucobot <noreply@send.aucobot.com>"
EMAIL_OTP_EXPIRES_MINUTES=10
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_IP_MAX_REQUESTS=10
EMAIL_OTP_IP_WINDOW_SECONDS=600

# HMAC secret OTP — khác JWT_SECRET, ≥32 ký tự
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_OTP_HMAC_SECRET="CHANGE_ME_generate_with_crypto_randomBytes_32"

# Redis (OTP rate limits + BullMQ / cron)
REDIS_URL="redis://default:PASSWORD@HOST:6379"
REDIS_KEY_PREFIX="aucobot:"

# Feature plugins (CSV). Id hợp lệ: facebook,tiktok,publishing,approvals,documents,web-search,ai-orchestration
ENABLED_FEATURES=ai-orchestration,documents,web-search

# Together AI (server-only)
TOGETHER_API_KEY=
TOGETHER_MODEL=Qwen/Qwen2.5-7B-Instruct-Turbo

# Tavily (web_search)
TAVILY_API_KEY=

# Cloudflare R2 (documents)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ----------------------------- NEXTJS Frontend (Vercel) -----------------------------

NEXT_PUBLIC_API_URL="https://api.aucobot.com"
NEXT_PUBLIC_APP_URL="https://app.aucobot.com"
NEXT_PUBLIC_MARKETING_URL="https://www.aucobot.com"

# Waitlist — server-only trên Vercel env
WAITLIST_SHEET_WEBHOOK_URL=
