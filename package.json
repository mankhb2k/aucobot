{
  "name": "aucobot",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @aucobot/web dev",
    "dev:api": "pnpm --filter @aucobot/api dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @aucobot/database db:generate",
    "db:migrate": "pnpm --filter @aucobot/database db:migrate",
    "db:push": "pnpm --filter @aucobot/database db:push",
    "db:studio": "pnpm --filter @aucobot/database db:studio",
    "docker:api:release": "powershell -ExecutionPolicy Bypass -File scripts/docker-api.ps1"
  },
  "devDependencies": {
    "only-allow": "^1.2.1",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.9",
    "pnpm": ">=9"
  }
}
